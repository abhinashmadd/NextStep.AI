# ========================================================
# NextStep Career Guidance Platform - Configuration
# ========================================================

# NVIDIA NIM LLM Configuration (OpenAI-compatible protocol)
# Get your API key from NVIDIA build portal (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3
NVIDIA_REQUEST_TIMEOUT=180.0

# LLM Provider ('nvidia' or 'mock' for offline testing)
LLM_PROVIDER=nvidia

# RAG Embedding Configuration
# Options: 'chroma_default' (local ONNX all-MiniLM-L6-v2), 'fast_local', 'nvidia'
EMBEDDING_PROVIDER=chroma_default

# RAG Vector Database Configuration
# Options: 'chroma' (persistent local) or 'memory' (in-memory)
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=data/vector_db

# RAG Retrieval & Reranking Settings
RETRIEVAL_TOP_K=15
RELEVANCE_THRESHOLD=0.30
RERANKING_ENABLED=true
RERANKER_PROVIDER=hybrid
MAX_CONTEXT_TOKENS=3500

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
